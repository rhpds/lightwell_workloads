---
apiVersion: v1
kind: Service
metadata:
  name: {{ ocp4_workload_lightwell_demo_name }}
  namespace: {{ ocp4_workload_lightwell_demo_namespace }}
spec:
  ports:
  - name: http
    port: {{ ocp4_workload_lightwell_demo_container_port }}
    protocol: TCP
    targetPort: {{ ocp4_workload_lightwell_demo_container_port }}
  selector:
    app: {{ ocp4_workload_lightwell_demo_name }}
  sessionAffinity: None
  type: ClusterIP
